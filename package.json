{
  "name": "project-web-pilot",
  "productName": "Project Web Pilot",
  "version": "0.6.116",
  "description": "Локальный проект и ChatGPT в одном окне",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "license": "UNLICENSED",
  "scripts": {
    "stage:workflow-kit": "node scripts/stage-workflow-kit.mjs",
    "prestart": "npm run stage:workflow-kit && npm run stage:page-observer",
    "start": "electron .",
    "build": "npm run build:win",
    "prebuild:win": "npm run stage:workflow-kit && npm run stage:page-observer",
    "build:win": "npm run prepare:win && npm run build:win:package && npm run verify:win",
    "prepare:win": "node scripts/prepare-windows-toolchain.mjs",
    "build:win:package": "electron-packager . \"Project Web Pilot\" --platform=win32 --arch=x64 --out=.harness/runtime/build --overwrite --asar --extra-resource=resources --extra-resource=tools/codex-app-server-mcp --extra-resource=.harness/runtime/windows-payload --extra-resource=.harness/runtime/windows-node --ignore=\"^/(?!(src|node_modules)(/|$)|(package\\.json|LICENSE)$)\"",
    "verify:win": "node scripts/verify-windows-package.mjs",
    "stage:page-observer": "node scripts/stage-page-observer.mjs",
    "check:codex-tools": "node scripts/check-codex-tools.mjs"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/osx-sign": "2.7.0",
    "@electron/packager": "20.3.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6"
  },
  "dependencies": {
    "@webpilot/workflow-kit": "file:packages/workflow-kit"
  }
}
